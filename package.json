{
  "name": "commercial-intelligence-layer",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial intelligence layer for a life-sciences tools company: synthetic data, SQL models (DuckDB), Next.js dashboard, plain-English text-to-SQL. Demo for hiring managers.",
  "scripts": {
    "postinstall": "node scripts/copy-duckdb-assets.mjs && node scripts/decode-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve:static": "npx serve out",
    "data:generate": "python3 scripts/generate_data.py",
    "warehouse:build": "python3 scripts/build_warehouse.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
